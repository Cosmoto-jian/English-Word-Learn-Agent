# Environment Configuration Example
# Copy this file to .env and fill in your credentials

# Text Generation Models
# Mistral AI API Key (for word explanations)
MISTRAL_API_KEY=your_mistral_api_key_here

# DeepSeek AI API Key (alternative text generation model)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (alternative text generation model & Imagen for image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# SiliconFlow API Key (fallback for image generation when Gemini is unavailable)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Audio Generation Models
# Deepgram API Key (for text-to-speech)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# AWS Configuration (for Polly text-to-speech)
AWS_PROFILE=EAP001
AWS_REGION=us-east-1

# Server Configuration (optional)
# Change PORT to avoid conflicts with system services
# PORT=5500  # Recommended: use 5500, 8000, or 8080 to avoid Chrome conflicts
# HOST=127.0.0.1
# DEBUG=false  # Set to 'true' for development, 'false' for production/background running
